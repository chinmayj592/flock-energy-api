{
  "openapi": "3.0.3",
  "info": {
    "title": "Flock Energy API",
    "description": "Clean REST API over the Urja Meter Ops legacy portal. Retrieves meter and transformer data, normalizes it, and exposes stable JSON endpoints.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Meters" },
    { "name": "Transformers" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "description": "Returns service status. Does not depend on the legacy portal.",
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": ["Meters"],
        "summary": "List meters",
        "description": "Returns a paginated list of meters. The `q` parameter is forwarded directly to the portal search endpoint.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search text — matches partial meter ID or serial number.",
            "required": false,
            "schema": { "type": "string", "default": "" }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number, 1-based.",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated meter list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeterListResponse" },
                "example": {
                  "data": [
                    {
                      "meterId": "J100000",
                      "serialNumber": "SE33962",
                      "make": "HPL",
                      "phaseType": "Single",
                      "installationStatus": "Decommissioned",
                      "transformerCode": "DT-001"
                    }
                  ],
                  "pagination": { "total": 403, "page": 1, "pageSize": 20 }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "502": { "$ref": "#/components/responses/PortalError" }
        }
      }
    },
    "/api/v1/meters/{meterId}": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter detail",
        "description": "Returns meter nameplate fields, location, and consumption readings. Makes three portal requests in parallel (search, geo, energy).",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Full meter detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeterDetailResponse" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "502": { "$ref": "#/components/responses/PortalError" }
        }
      }
    },
    "/api/v1/meters/{meterId}/location": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter location",
        "description": "Returns the geographical coordinates of a meter. Coordinates are returned as numbers — the portal returns them as strings, which are parsed at the boundary.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "J100000"
          }
        ],
        "responses": {
          "200": {
            "description": "Meter location",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeterLocationResponse" },
                "example": {
                  "data": {
                    "latitude": 26.938961002479868,
                    "longitude": 75.83095696146852
                  }
                }
              }
            }
          },
          "502": { "$ref": "#/components/responses/PortalError" }
        }
      }
    },
    "/api/v1/meters/{meterId}/consumption": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get meter consumption",
        "description": "Returns energy consumption readings for a meter. Readings are half-hourly. All numeric values are parsed from strings at the boundary. Timestamp format is DD/MM/YYYY HH:mm — timezone is unverified.",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "J100000"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of readings to return. Applied locally after fetching from portal.",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Consumption readings",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConsumptionResponse" },
                "example": {
                  "data": [
                    {
                      "timestamp": "23/06/2026 23:30",
                      "kwh": 48438.74,
                      "kvah": 52313.84,
                      "voltageR": 226
                    }
                  ],
                  "meta": { "meterId": "J100000", "count": 1 }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "502": { "$ref": "#/components/responses/PortalError" }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": ["Transformers"],
        "summary": "List transformers",
        "description": "Returns a paginated list of distribution transformers.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated transformer list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransformerListResponse" },
                "example": {
                  "data": [
                    {
                      "transformerId": "DT-001",
                      "name": "Malviya Nagar DT 1",
                      "feeder": "F-001",
                      "capacityKva": 100
                    }
                  ],
                  "pagination": { "total": 40, "page": 1, "pageSize": 20 }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" },
          "502": { "$ref": "#/components/responses/PortalError" }
        }
      }
    },
    "/api/v1/transformers/{transformerId}/meters": {
      "get": {
        "tags": ["Transformers"],
        "summary": "Get meters for a transformer",
        "description": "Returns meters associated with a transformer. Fetches the meter list using the transformer ID as a search hint, then filters locally by transformer code. Limited to page 1 of portal results.",
        "parameters": [
          {
            "name": "transformerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "DT-001"
          }
        ],
        "responses": {
          "200": {
            "description": "Meters for the transformer",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransformerMetersResponse" }
              }
            }
          },
          "502": { "$ref": "#/components/responses/PortalError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "example": 403 },
          "page": { "type": "integer", "example": 1 },
          "pageSize": { "type": "integer", "example": 20 }
        }
      },
      "MeterSummary": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string", "example": "J100000" },
          "serialNumber": { "type": "string", "nullable": true, "example": "SE33962" },
          "make": { "type": "string", "nullable": true, "example": "HPL" },
          "phaseType": { "type": "string", "nullable": true, "example": "Single" },
          "installationStatus": { "type": "string", "nullable": true, "example": "Decommissioned" },
          "transformerCode": { "type": "string", "nullable": true, "example": "DT-001" }
        }
      },
      "MeterLocation": {
        "type": "object",
        "properties": {
          "latitude": { "type": "number", "nullable": true, "example": 26.938961002479868 },
          "longitude": { "type": "number", "nullable": true, "example": 75.83095696146852 }
        }
      },
      "ConsumptionReading": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "example": "23/06/2026 23:30", "description": "DD/MM/YYYY HH:mm — timezone unverified" },
          "kwh": { "type": "number", "nullable": true, "example": 48438.74 },
          "kvah": { "type": "number", "nullable": true, "example": 52313.84 },
          "voltageR": { "type": "number", "nullable": true, "example": 226 }
        }
      },
      "TransformerSummary": {
        "type": "object",
        "properties": {
          "transformerId": { "type": "string", "example": "DT-001" },
          "name": { "type": "string", "nullable": true, "example": "Malviya Nagar DT 1" },
          "feeder": { "type": "string", "nullable": true, "example": "F-001" },
          "capacityKva": { "type": "number", "nullable": true, "example": 100 }
        }
      },
      "MeterListResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/MeterSummary" } },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "MeterDetailResponse": {
        "type": "object",
        "properties": {
          "data": {
            "allOf": [
              { "$ref": "#/components/schemas/MeterSummary" },
              {
                "type": "object",
                "properties": {
                  "location": { "$ref": "#/components/schemas/MeterLocation" },
                  "consumption": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/ConsumptionReading" }
                  }
                }
              }
            ]
          }
        }
      },
      "MeterLocationResponse": {
        "type": "object",
        "properties": {
          "data": { "$ref": "#/components/schemas/MeterLocation" }
        }
      },
      "ConsumptionResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/ConsumptionReading" } },
          "meta": {
            "type": "object",
            "properties": {
              "meterId": { "type": "string" },
              "count": { "type": "integer" }
            }
          }
        }
      },
      "TransformerListResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/TransformerSummary" } },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "TransformerMetersResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/MeterSummary" } },
          "meta": {
            "type": "object",
            "properties": {
              "transformerId": { "type": "string" },
              "count": { "type": "integer" }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": { "type": "string", "example": "Invalid request parameters" },
              "details": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Invalid request parameters",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": { "code": "VALIDATION_ERROR", "message": "Invalid request parameters", "details": [{ "field": "page", "message": "page must be >= 1" }] }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": { "code": "METER_NOT_FOUND", "message": "Meter J999999 not found", "details": [] }
            }
          }
        }
      },
      "PortalError": {
        "description": "Legacy portal unavailable or returned an error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": { "code": "PORTAL_UNAVAILABLE", "message": "Portal unavailable: connect ECONNREFUSED", "details": [] }
            }
          }
        }
      }
    }
  }
}
